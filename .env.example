# 复制成 .env 后按现场改；.env 已在 .gitignore 里，不要提交。
# 密钥只放这里（或企业密钥管理注入），不要写进 Team JSON / opencode 配置文件的明文。

# 必填：opencode server 的 Basic Auth 口令（客户端用户名固定为 opencode）。
# 生成：openssl rand -hex 24
OPENCODE_SERVER_PASSWORD=change-me

# 执行底座版本：引擎契约只在 1.18.x 实测过，升级前重跑真机冒烟。
OPENCODE_VERSION=1.18.32

# 默认模型 provider/model。企业内网请把 provider 指向自建网关
# （vLLM / Ollama / DeepSeek 自托管 / LiteLLM），保证数据不出域。
AGENTTEAM_OC_MODEL=opencode/ling-3.0-flash-fin-free

# Team 未声明 engine 时的全站默认：langgraph | opencode
AGENTTEAM_DEFAULT_ENGINE=langgraph

# 白名单外工具调用的处置：strict（中断+审批，事后审计）| audit（只记账继续跑）| off
AGENTTEAM_OC_TOOL_GUARD=strict

# 单次 prompt 等待上限（秒）。长任务调大，别让它无限挂着。
AGENTTEAM_OC_TIMEOUT=600

# 被研发的目标仓库（worker 的 write_file / bash 都落在容器 /workspace）。
AGENTTEAM_WORKSPACE=./workspace

# 若复用外部已有的 opencode server：取消注释并 --scale opencode=0
# AGENTTEAM_OPENCODE_URL=http://127.0.0.1:4117

# provider 密钥：透传给 opencode 容器，配置文件里用 {env:VAR} 引用。
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
